# Public URL of the deployed site (used for canonical URLs, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Optional: enables direct sending from the enquiry form via Resend (https://resend.com).
# Without these, the form validates input and hands off to the visitor's email app instead.
RESEND_API_KEY=
CONTACT_TO_EMAIL=Varshithtriparna12@gmail.com
# Must be an address on a domain verified in Resend, e.g. "Portfolio <enquiries@your-domain.com>".
CONTACT_FROM_EMAIL=
